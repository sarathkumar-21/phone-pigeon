{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PhonePigeon",
  "version": "0.1.0",
  "identifier": "dev.phonepigeon.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "label": "main", "title": "PhonePigeon", "width": 1240, "height": 800, "minWidth": 900, "minHeight": 600 }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: pigeon: http://pigeon.localhost; media-src 'self' blob: pigeon: http://pigeon.localhost; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost pigeon: http://pigeon.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "deb", "appimage", "rpm"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Productivity",
    "shortDescription": "Texts, calls, photos and files from your Android phone",
    "linux": { "deb": { "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"] } }
  }
}
